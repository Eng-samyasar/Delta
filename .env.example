# Delta General Supplies - Environment Variables Example
# انسخ هذا الملف إلى .env عند النشر ولا تقم برفع ملف .env الحقيقي إلى Git أبداً

# إعدادات النطاق والبيئة
SITE_URL=https://deltasupplies-eg.com
NODE_ENV=production

# إعدادات البريد أو Webhook الخاص باستلام عروض الأسعار
QUOTE_NOTIFICATION_EMAIL=sales@deltasupplies-eg.com
SMTP_HOST=smtp.deltasupplies-eg.com
SMTP_PORT=587
SMTP_USER=info@deltasupplies-eg.com
SMTP_PASSWORD=your_secure_password_here

# في حال تفعيل حماية Cloudflare Turnstile مستقبلاً
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
